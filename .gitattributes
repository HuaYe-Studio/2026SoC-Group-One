# 自动检测文本文件，统一使用 LF
* text=auto
# 明确指定这些文件使用 LF（Unity 的核心文本资产）
*.cs text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.json text eol=lf
*.shader text eol=lf
*.txt text eol=lf
# 二进制文件（防止 Git 自作聪明去转换它们）
*.png binary
*.jpg binary
*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 binary
*.dll binary
*.so binary
*.a binary
*.exe binary
*.aiff filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
